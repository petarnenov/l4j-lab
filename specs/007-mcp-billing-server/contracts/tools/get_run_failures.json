{
  "name" : "get_run_failures",
  "title" : "Get billing run failures",
  "description" : "For a failed billing run, list the households the run could not process and why. The list is capped; total_count says how many failures exist in all.",
  "inputSchema" : {
    "additionalProperties" : false,
    "properties" : {
      "limit" : {
        "description" : "Maximum households to return. Defaults to 50. A larger value is clamped to 50 rather than refused.",
        "default" : 50,
        "type" : "integer"
      },
      "run_id" : {
        "description" : "The failed run to inspect.",
        "type" : "string"
      }
    },
    "required" : [ "run_id" ],
    "type" : "object"
  },
  "outputSchema" : {
    "title" : "RunFailuresResult",
    "description" : "Households a failed billing run could not process, with the cause of each.",
    "$id" : "http://localhost:8080/schemas/run-failures-result.schema.json",
    "$schema" : "https://json-schema.org/draft/2020-12/schema",
    "properties" : {
      "failures" : {
        "items" : {
          "title" : "RunFailure",
          "description" : "One household a failed run could not process, and why (FR-019).",
          "properties" : {
            "cause" : {
              "type" : "string"
            },
            "household_id" : {
              "type" : "string"
            },
            "household_name" : {
              "type" : "string"
            }
          },
          "type" : "object"
        },
        "type" : "array"
      },
      "run_id" : {
        "type" : "string"
      },
      "total_count" : {
        "type" : "integer"
      },
      "truncated" : {
        "type" : "boolean"
      }
    },
    "required" : [ "total_count", "truncated" ],
    "type" : "object"
  },
  "annotations" : {
    "title" : "",
    "destructiveHint" : false,
    "idempotentHint" : true,
    "openWorldHint" : true,
    "readOnlyHint" : true,
    "returnDirect" : false
  }
}
