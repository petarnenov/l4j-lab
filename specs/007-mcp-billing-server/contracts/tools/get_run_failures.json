{
  "name": "get_run_failures",
  "title": "Get billing run failures",
  "description": "For a failed billing run, list the households the run could not process and why. The list is capped; total_count says how many failures exist in all.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "run_id": {
        "type": "string",
        "description": "The failed run to inspect."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 50,
        "description": "Maximum households to return. Values above 50 are clamped to 50."
      }
    },
    "required": ["run_id"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "run_id": { "type": "string" },
      "failures": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "properties": {
            "household_id": { "type": "string" },
            "household_name": { "type": "string" },
            "cause": { "type": "string" }
          },
          "required": ["household_id", "household_name", "cause"],
          "additionalProperties": false
        }
      },
      "total_count": {
        "type": "integer",
        "minimum": 0,
        "description": "Total failed households, which may exceed the length of failures."
      },
      "truncated": { "type": "boolean" }
    },
    "required": ["run_id", "failures", "total_count", "truncated"],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  }
}
